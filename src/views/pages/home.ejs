        <a href="#" data-modal-trigger="auth" data-tab="login">Connexion</a>
        <a href="#" data-modal-trigger="auth" data-tab="register">Inscription patient</a>
      </nav>
      <div class="lp-footer-col">
        <h4>Contact</h4>
        <p style="font-size:14px;color:#8EA5BF;margin-bottom:8px">+216 70 123 456</p>
        <p style="font-size:14px;color:#8EA5BF;margin-bottom:8px">contact@meditrack.test</p>
        <p style="font-size:14px;color:#8EA5BF">Tunis, Tunisie (fictif)</p>
      </div>
    </div>
    <div class="lp-footer-bottom">
      <span>© 2026 MediTrack · Projet universitaire DevSecOps</span>
