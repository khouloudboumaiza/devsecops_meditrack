  <div class="lp-container">
    <div class="lp-footer-in">
      <div>
        <a class="brand" href="/">
          <img src="/icons/logo.svg" alt="" width="32" height="32">
          MediTrack
        </a>
        <p class="lp-footer-desc">
          Plateforme de prise de rendez-vous médicaux.
