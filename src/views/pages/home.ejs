<!-- ===== POPUP AUTH ===== -->
<div class="modal-overlay" id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title" hidden>
  <div class="modal" id="auth-dialog">
    <div class="modal-header">
      <h2 id="auth-modal-title">Connexion</h2>
      <button class="modal-close" id="modal-close-btn" aria-label="Fermer">
        <span class="icon i-x" aria-hidden="true"></span>
      </button>
    </div>
    <div class="modal-body">
      <!-- Onglets -->
      <div class="modal-tabs" role="tablist">
        <button class="modal-tab active" role="tab" id="tab-login" aria-selected="true" aria-controls="panel-login">
          Connexion
        </button>
        <button class="modal-tab" role="tab" id="tab-register" aria-selected="false" aria-controls="panel-register">
          Inscription
        </button>
      </div>

      <!-- Panneau Connexion -->
      <div class="modal-panel active" id="panel-login" role="tabpanel" aria-labelledby="tab-login">
        <div class="alert alert-error" id="login-error" hidden role="alert"></div>
        <form class="form" id="login-form" novalidate>
          <div class="field">
            <label for="login-email">Adresse e-mail</label>
            <input id="login-email" name="email" type="email" required autocomplete="email" placeholder="vous@exemple.com">
            <small class="field-error" data-error-for="login-email" role="alert"></small>
          </div>
          <div class="field">
            <label for="login-password">Mot de passe</label>
            <input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
            <small class="field-error" data-error-for="login-password" role="alert"></small>
          </div>
          <button class="btn btn-block" type="submit" id="login-btn">Se connecter</button>
        </form>
        <div class="demo-box" style="margin-top:var(--s1)">
          <strong>Comptes de test :</strong><br>
          patient1@meditrack.test — medecin1@meditrack.test<br>
          Mot de passe : <strong>Password123!</strong>
        </div>
      </div>

      <!-- Panneau Inscription -->
      <div class="modal-panel" id="panel-register" role="tabpanel" aria-labelledby="tab-register" hidden>
        <div class="alert alert-error" id="register-error" hidden role="alert"></div>
        <form class="form" id="register-form" novalidate>
          <div class="field">
            <label for="reg-name">Nom complet</label>
            <input id="reg-name" name="nom" type="text" required minlength="2" maxlength="100" autocomplete="name" placeholder="Prénom Nom">
            <small class="field-error" data-error-for="reg-name" role="alert"></small>
          </div>
          <div class="field">
            <label for="reg-email">Adresse e-mail</label>
            <input id="reg-email" name="email" type="email" required autocomplete="email" placeholder="vous@exemple.com">
            <small class="field-error" data-error-for="reg-email" role="alert"></small>
          </div>
          <div class="field">
            <label for="reg-password">Mot de passe</label>
            <input id="reg-password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="8 caractères minimum">
            <small class="field-error" data-error-for="reg-password" role="alert"></small>
          </div>
          <div class="field">
            <label for="reg-confirm">Confirmer le mot de passe</label>
            <input id="reg-confirm" name="confirm" type="password" required autocomplete="new-password" placeholder="••••••••" data-match="reg-password">
            <small class="field-error" data-error-for="reg-confirm" role="alert"></small>
          </div>
          <button class="btn btn-block" type="submit" id="register-btn">Créer mon compte</button>
        </form>
      </div>

      <p class="modal-footer-link">
        <a href="#" id="switch-tab-link">Pas encore inscrit ? Créer un compte</a>
      </p>
    </div>
  </div>
</div>