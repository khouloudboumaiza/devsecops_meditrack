<%# a = rendez-vous ; who = nom affiché ; sub = sous-titre %>
<article class="card appt">
  <div class="appt-top">
    <span class="avatar <%= avatarClass(a.medecin_id || a.patient_id) %>" aria-hidden="true"><%= initials(who) %></span>
    <div><h3><%= who %></h3><p class="muted small"><%= sub %></p></div>
    <span class="badge <%= badgeClass(a.etat) %>"><%= statutLabel(a.etat) %></span>
  </div>
  <div class="appt-meta">
    <span><span class="icon icon-sm i-calendar" aria-hidden="true"></span><%= fmtDate(a.date) %></span>
    <span><span class="icon icon-sm i-clock" aria-hidden="true"></span><%= a.heure %></span>
    <span><span class="icon icon-sm <%= a.type === 'en_ligne' ? 'i-video' : 'i-building' %>" aria-hidden="true"></span><%= typeLabel(a.type) %></span>
  </div>
  <p class="appt-motif"><strong>Motif :</strong> <%= a.motif %></p>
  <% if (typeof cancellable !== 'undefined' && cancellable) { %>
    <div class="appt-actions">
      <form method="post" action="/rendez-vous/<%= a.id %>/annuler" data-confirm="Annuler ce rendez-vous ?">
        <button class="btn btn-danger-outline" type="submit">Annuler</button>
      </form>
    </div>
  <% } %>
</article>
