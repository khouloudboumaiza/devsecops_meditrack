<%
  var roleLabel = { admin: 'Administrateur', secretaire: 'Secrétaire', medecin: 'Médecin', patient: 'Patient' }[user.role] || user.role;
%>
<aside class="sidebar" aria-label="Navigation principale">
  <a class="brand" href="/"><img src="/icons/logo.svg" alt="" width="36" height="36">MediTrack</a>
  <nav class="side-nav">
    <% navItems(user.role).forEach(function (item) { %>
      <a href="<%= item.href %>" <%- isActive(item, currentPath) ? 'aria-current="page"' : '' %>>
        <span class="icon i-<%= item.icon %>" aria-hidden="true"></span><%= item.label %>
      </a>
    <% }) %>
  </nav>
  <div class="side-user">
    <div class="side-user-info">
      <span class="avatar <%= avatarClass(user.id) %>" aria-hidden="true"><%= initials(user.nom) %></span>
      <div>
        <strong><%= user.nom %></strong>
        <span class="muted small"><%= roleLabel %></span>
      </div>
    </div>
    <form method="post" action="/logout">
      <button class="btn btn-outline btn-block btn-sm" type="submit">
        <span class="icon icon-sm i-logout" aria-hidden="true"></span>Déconnexion
      </button>
    </form>
  </div>
</aside>
