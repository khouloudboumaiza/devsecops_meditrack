# Copier vers .env puis remplir :  cp .env.example .env
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).
# Générer un secret :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=3000
NODE_ENV=development

# Mot de passe de la base PostgreSQL (utilisé par docker compose)
POSTGRES_PASSWORD=

# Secret de signature des JWT (obligatoire, 32 caractères aléatoires ou plus)
JWT_SECRET=

# Clé du service de notification (facultative)
API_KEY=

# Lancement sans Docker (npm start) : connexion à la base par les variables PG*
PGHOST=localhost
PGPORT=5432
PGUSER=meditrack
PGDATABASE=meditrack
PGPASSWORD=

# Mot de passe administrateur de Grafana (supervision, docker-compose.monitoring.yml)
GRAFANA_ADMIN_PASSWORD=
